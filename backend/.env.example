# Copy to .env and fill in.

# ---- LLM (Gemini) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.6-flash
# Thinking level: minimal | low | medium | high (leave empty for the model default)
RUN_THINKING=low
JUDGE_THINKING=low
MAX_OUTPUT_TOKENS=4096
# Parallel test cases per request / across the whole server. Lower if you hit 429s.
MAX_CONCURRENCY=3
GLOBAL_LLM_CONCURRENCY=20
# Test-case executions each user may spend per day (protects your API quota).
# Only real model calls count: cached answers and tests skipped after a failure are free.
DAILY_TEST_BUDGET=300

# ---- Free-tier quota handling ----
# Backup models on a separate free quota, used only when Gemini is out of quota or too busy.
# Free key (no card) at https://console.groq.com/keys - leave empty for Gemini only.
GROQ_API_KEY=
# Backups tried in order, as provider:model (provider = gemini or groq). Empty = no backups.
RUN_FALLBACK_MODELS=groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b
JUDGE_FALLBACK_MODELS=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite
DAILY_FALLBACK_MODELS=groq:openai/gpt-oss-120b
# Per-model pacing overrides: model=requests_per_min:tokens_per_min:requests_per_day (0 = none).
# Check your real Gemini numbers at https://aistudio.google.com/rate-limit. Example:
#   MODEL_LIMITS=gemini-3.5-flash-lite=15:0:1000,gemini-3.6-flash=10:0:250
MODEL_LIMITS=
# Seconds to wait for the main model's capacity before using a backup, and max wait per request.
FALLBACK_WAIT_SECONDS=10
USER_WAIT_SECONDS=45
# Identical requests reuse a stored answer for this many days (0 = no cache).
LLM_CACHE_DAYS=30
# Temperature for solver prompts (empty = model default).
RUN_TEMPERATURE=
# Let users add their own Gemini key in Settings (their runs then skip your quota and budgets).
ALLOW_USER_KEYS=true
# Encrypts users' stored keys. Defaults to a key derived from JWT_SECRET - set it separately so
# rotating JWT_SECRET doesn't make saved keys unreadable.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KEY_ENCRYPTION_SECRET=

# ---- Daily challenge ----
# A new problem every day at midnight UTC: from the admin queue, else generated by Gemini and
# only published after its reference prompt passes all tests.
DAILY_ENABLED=true
# Background job that prepares today's + tomorrow's problem. With several server instances,
# enable it on one only (or set false everywhere and run `python -m app.daily` from cron).
DAILY_SCHEDULER=true
DAILY_MODEL=gemini-3.6-flash
DAILY_GENERATION_ATTEMPTS=3

# ---- Streak reminder emails ----
# After this UTC hour, users whose streak is about to end get one email a day (opt-out in Settings).
REMINDERS_ENABLED=true
REMINDER_HOUR_UTC=18
# Most reminders per day. Resend's free plan allows 100 emails a day in total.
REMINDER_DAILY_CAP=90

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_HOURS=168
# Google sign-in: an OAuth "Web application" client ID. Leave empty to hide the button.
GOOGLE_CLIENT_ID=

# Site-wide cap on Gemini tokens per UTC day (0 = no cap). Runs/submits pause once reached.
DAILY_TOKEN_CAP=0

# ---- Email (verification + password reset) ----
# Public site URL, used in email links (no trailing slash).
APP_URL=http://localhost:5173
# console = print emails (with their links) in the backend terminal; resend = really send.
# Defaults to resend when RESEND_API_KEY is set.
EMAIL_BACKEND=console
RESEND_API_KEY=
# Must be on a domain you verified in Resend. onboarding@resend.dev only delivers to your own address.
EMAIL_FROM=PromptCode <onboarding@resend.dev>
# Require a verified email before publishing problems.
REQUIRE_VERIFIED_TO_PUBLISH=true
# Let every user create problems. false = only admins can, and problems made earlier by
# non-admins are hidden (kept in the database; set true again to restore them).
ALLOW_USER_PROBLEMS=false

# Public contact address shown on the Privacy Policy and Terms pages.
CONTACT_EMAIL=

# ---- Monitoring ----
# Sentry DSN for error reporting (optional).
SENTRY_DSN=

# ---- Deployment ----
# development | production (production refuses unsafe settings and hides /docs)
ENVIRONMENT=development
# true when served over HTTPS (required in production)
COOKIE_SECURE=false
# true only behind a reverse proxy you control (uses X-Forwarded-For for rate limits).
# The client IP is read this many entries from the right of X-Forwarded-For.
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1
# Defaults to APP_URL.
CORS_ORIGINS=http://localhost:5173

# SQLite for local dev; Postgres for production (pip install "psycopg[binary]"):
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/promptcode
DATABASE_URL=sqlite:///./promptcode.db
# Apply migrations at startup. With several instances, set false and run `alembic upgrade head` on deploy.
AUTO_MIGRATE=true

# Rate-limit counters: memory:// for one process; Redis to share across instances (pip install redis):
#   RATE_LIMIT_STORAGE=redis://localhost:6379
RATE_LIMIT_STORAGE=memory://
